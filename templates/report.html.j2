<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><title>Validation Report</title>
<style>
body{font-family:Arial,sans-serif;margin:40px;background:#fafafa;color:#111827}
.card{background:#fff;padding:20px;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.06);margin-bottom:20px}
table{border-collapse:collapse;width:100%}td,th{border:1px solid #ddd;padding:8px}th{background:#f3f4f6}.ok{color:green}.bad{color:red}.warn{color:#b45309}pre{background:#f9fafb;padding:16px;white-space:pre-wrap;border-radius:8px}
ul{padding-left:20px}
</style>
</head><body>
<div class="card">
<h1>Отчёт о валидации конфигурации</h1>
<p><strong>Устройство:</strong> {{ hostname }}</p>
<p><strong>Вендор:</strong> {{ vendor }}</p>
<p><strong>Профиль:</strong> {{ profile or 'default' }}</p>
<p><strong>Статус:</strong> <span class="{{ 'ok' if status == 'passed' else 'bad' }}">{{ status }}</span></p>
</div>
<div class="card">
<h2>Рекомендации</h2>
{% if recommendations %}<ul>{% for rec in recommendations %}<li>{{ rec }}</li>{% endfor %}</ul>{% else %}<p>Критических рекомендаций нет.</p>{% endif %}
</div>
<div class="card">
<h2>Ошибки</h2><table><tr><th>Код</th><th>Категория</th><th>Серьёзность</th><th>Сообщение</th><th>Путь</th></tr>{% for i in errors %}<tr><td>{{ i.code }}</td><td>{{ i.category or '' }}</td><td>{{ i.severity }}</td><td>{{ i.message }}</td><td>{{ i.path or '' }}</td></tr>{% endfor %}</table>
</div>
<div class="card">
<h2>Предупреждения</h2><table><tr><th>Код</th><th>Категория</th><th>Серьёзность</th><th>Сообщение</th><th>Путь</th></tr>{% for i in warnings %}<tr><td>{{ i.code }}</td><td>{{ i.category or '' }}</td><td>{{ i.severity }}</td><td>{{ i.message }}</td><td>{{ i.path or '' }}</td></tr>{% endfor %}</table>
</div>
<div class="card">
<h2>Тесты</h2><table><tr><th>Тест</th><th>Статус</th><th>Детали</th></tr>{% for t in tests %}<tr><td>{{ t.name }}</td><td>{{ t.status }}</td><td>{{ t.details }}</td></tr>{% endfor %}</table>
</div>
<div class="card">
<h2>Метрики</h2><pre>{{ metrics | tojson(indent=2) }}</pre>
</div>
<div class="card">
<h2>Нормализованная конфигурация</h2><pre>{{ normalized_config | tojson(indent=2) }}</pre>
</div>
</body></html>
