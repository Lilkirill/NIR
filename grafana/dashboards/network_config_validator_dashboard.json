          "rawSql": "SELECT\n  CASE COALESCE(vr.run_kind, 'не указан')\n    WHEN 'api' THEN 'API'\n    WHEN 'dataset' THEN 'Датасет'\n    WHEN 'regression' THEN 'Регрессия'\n    WHEN 'negative' THEN 'Негативный тест'\n    ELSE REPLACE(COALESCE(vr.run_kind, 'не указан'), '_', ' ')\n  END AS \"Тип запуска\",\n  CASE COALESCE(vr.source_scope, 'не указан')\n    WHEN 'dataset' THEN 'Датасет'\n    WHEN 'lab' THEN 'Лабораторный'\n    WHEN 'unknown' THEN 'Не указан'\n    WHEN 'raw' THEN 'Полный конфиг'\n    WHEN 'partial' THEN 'Фрагмент'\n    ELSE REPLACE(COALESCE(vr.source_scope, 'не указан'), '_', ' ')\n  END AS \"Источник\",\n  CASE COALESCE(vr.dataset_name, '')\n    WHEN 'ncv_5vendor_mixed_1000' THEN 'Расширенный датасет 5 вендоров'\n    WHEN '' THEN 'Без датасета'\n    ELSE REPLACE(vr.dataset_name, '_', ' ')\n  END AS \"Датасет\",\n  COUNT(*) AS \"Всего\"\nFROM validation_runs vr\nGROUP BY vr.run_kind, vr.source_scope, vr.dataset_name\nORDER BY COUNT(*) DESC;",
          "refId": "A"
        }
      ],
